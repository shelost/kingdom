# Copy to `.env.local` (git-ignored) and fill in. Never commit real keys.

# Read dialogue aloud — used only by src/routes/api/tts/+server.ts.
# Without it the story still reads; the Voice control just reports that the
# server has no key.
OPENAI_API_KEY=

# Optional. Defaults to gpt-4o-mini-tts, the only family that accepts the
# per-character style directions this app sends. `tts-1` / `tts-1-hd` work too,
# and the route drops the directions for them.
# OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Optional. Point at an OpenAI-compatible gateway instead of api.openai.com.
# OPENAI_TTS_ENDPOINT=https://api.openai.com/v1/audio/speech
