{
	"id": "yYCbSl3lGq0",
	"source": "instrumental",
	"instrumental": true,
	"trackName": "Killmonger",
	"artistName": "Ludwig Göransson",
	"lines": [
		{
			"t": 0,
			"text": "♪",
			"scene": "Open the register."
		},
		{
			"t": 5,
			"text": "♪",
			"scene": "Say the name three times."
		},
		{
			"t": 10,
			"text": "♪",
			"scene": "Kangrim asks the question."
		},
		{
			"t": 15,
			"text": "♪",
			"scene": "I ask if they have last words."
		},
		{
			"t": 20,
			"text": "♪",
			"scene": "That's the whole kindness. Don't clap."
		},
		{
			"t": 25,
			"text": "♪",
			"scene": "We failed a king once."
		},
		{
			"t": 30,
			"text": "♪",
			"scene": "We do not intend to make it a style."
		},
		{
			"t": 35,
			"text": "♪",
			"scene": "Haewonmek. You talk too much tonight."
		},
		{
			"t": 40,
			"text": "♪",
			"scene": "The road is long. Humor me."
		},
		{
			"t": 45,
			"text": "♪",
			"scene": "No."
		},
		{
			"t": 50,
			"text": "♪",
			"scene": "Fine. Walk."
		},
		{
			"t": 55,
			"text": "♪",
			"scene": "The cord cuts the same in Silla,"
		},
		{
			"t": 60,
			"text": "♪",
			"scene": "Baekje, Goguryeo, a kitchen."
		},
		{
			"t": 65,
			"text": "♪",
			"scene": "Death is not a patriot."
		},
		{
			"t": 70,
			"text": "♪",
			"scene": "We are clerks with knives."
		},
		{
			"t": 75,
			"text": "♪",
			"scene": "If you run, the name still fits"
		},
		{
			"t": 80,
			"text": "♪",
			"scene": "in the mouth. We practiced."
		},
		{
			"t": 85,
			"text": "♪",
			"scene": "Partner."
		},
		{
			"t": 90,
			"text": "♪",
			"scene": "If the ledger lies, we walk anyway"
		},
		{
			"t": 95,
			"text": "♪",
			"scene": "and fix the lie with a body."
		},
		{
			"t": 100,
			"text": "♪",
			"scene": "Sorry is not in the rite."
		},
		{
			"t": 105,
			"text": "♪",
			"scene": "Last words are."
		},
		{
			"t": 110,
			"text": "♪",
			"scene": "Any?"
		},
		{
			"t": 115,
			"text": "♪",
			"scene": "No?"
		},
		{
			"t": 120,
			"text": "♪",
			"scene": "Then come."
		},
		{
			"t": 125,
			"text": "♪",
			"scene": "The question, if you're lucky"
		},
		{
			"t": 130,
			"text": "♪",
			"scene": "enough to get the one who asks it."
		},
		{
			"t": 135,
			"text": "♪",
			"scene": "Most of you get me."
		},
		{
			"t": 140,
			"text": "♪",
			"scene": "I am shorter."
		},
		{
			"t": 145,
			"text": "♪",
			"scene": "I am not softer."
		},
		{
			"t": 150,
			"text": "♪",
			"scene": "Two shadows on a mortal road."
		},
		{
			"t": 155,
			"text": "♪",
			"scene": "We don't hurry."
		},
		{
			"t": 160,
			"text": "♪",
			"scene": "The dead have nowhere else to be,"
		},
		{
			"t": 165,
			"text": "♪",
			"scene": "and neither do we."
		},
		{
			"t": 170,
			"text": "♪",
			"scene": "Fetch."
		}
	]
}
