	"trackName": "I Believe",
	"artistName": "이수영",
	"lines": [
		{
			"t": 32.2,
			"text": "그때 그 약속을"
		},
		{
			"t": 36,
			"text": "기억하고"
		},
		{
			"t": 47.08,
			"text": "있을까요 많이"
		},
		{
			"t": 49.72,
			"text": "변했 내 모습을 알아볼까요"
		},
		{
			"t": 64.12,
			"text": "네가 전한"
		},
		{
			"t": 67.2,
			"text": "간날 너의 빈 책상"
		},
		{
			"t": 72.92,
			"text": "새겨져 있던 그 말을 난"
		},
		{
			"t": 79.28,
			"text": "기억해요 오늘이"
		},
		{
			"t": 83.2,
			"text": "바로 그대 약속한 그 날인걸요"
		},
		{
			"t": 110.8,
			"text": "운명이란 걸 난"
		},
		{
			"t": 118.84,
			"text": "느껴서요"
		},
		{
			"t": 123.28,
			"text": "블 친근한 말한 마디조차 한 적"
		},
		{
			"t": 139.16,
			"text": "없지만 슬픈 그대"
		},
		{
			"t": 143.28,
			"text": "얼굴 이유를"
		},
		{
			"t": 145.72,
			"text": "알았을 때"
		},
		{
			"t": 150.52,
			"text": "한 표정만 짓고"
		},
		{
			"t": 157.24,
			"text": "연락하기로"
		},
		{
			"t": 159.24,
			"text": "해 웃으며"
		},
		{
			"t": 161.8,
			"text": "말하던 너는"
		},
		{
			"t": 172.16,
			"text": "있니 제 못할 거란 걸 알고"
		},
		{
			"t": 178.84,
			"text": "있어 앞으로도"
		},
		{
			"t": 182.64,
			"text": "영원히 볼 수 없다는"
		},
		{
			"t": 186.8,
			"text": "것을 이젠이 세상에 너는"
		},
		{
			"t": 191.72,
			"text": "사람은 없는"
		},
		{
			"t": 194.56,
			"text": "거니 내가 잘못한 것이 길 비고 있어"
		},
		{
			"t": 203.76,
			"text": "약속하니 것은"
		}
	]
}
