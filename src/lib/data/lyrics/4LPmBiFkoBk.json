{
	"id": "4LPmBiFkoBk",
	"source": "lrclib",
	"trackName": "Try Again",
	"artistName": "JAEHYUN, d.ear",
	"lines": [
		{
			"t": 1.72,
			"text": "Uriga nanun",
			"scene": "Again. The vow doesn't expire"
		},
		{
			"t": 5.35,
			"text": "Gin siganmankeum neureonan gidaeneun",
			"scene": "just because I failed it pretty."
		},
		{
			"t": 10.32,
			"text": "Eojjeomyeon dangyeonhaljido molla",
			"scene": "Sadaham. Gaya road. Same feet."
		},
		{
			"t": 16.87,
			"text": "Sumaneun oechimdo",
			"scene": "Seven days. I remember the number"
		},
		{
			"t": 20.4,
			"text": "Seoroui mamen dachi mothan chae",
			"scene": "better than I remember sleep."
		},
		{
			"t": 25.49,
			"text": "Geureoke heulleogagido haetjiman",
			"scene": "If the dead keep promises,"
		},
		{
			"t": 32.85,
			"text": "So whenever you ask me again",
			"scene": "I am trying mine again."
		},
		{
			"t": 38.98,
			"text": "How I feel",
			"scene": "Not as a copy. As a man"
		},
		{
			"t": 40.89,
			"text": "Please remember",
			"scene": "who saw the gate and didn't blink"
		},
		{
			"t": 43.15,
			"text": "My answer is you",
			"scene": "long enough."
		},
		{
			"t": 47.54,
			"text": "Meon gireul dasi doraganda haedo",
			"scene": "The moon was a witness once."
		},
		{
			"t": 52.74,
			"text": "Nan yeojeonhi gateun mamil tenikka",
			"scene": "It can be a witness twice."
		},
		{
			"t": 56.24,
			"text": "We'll be alright",
			"scene": "I don't get to be tired"
		},
		{
			"t": 58.24,
			"text": "I want to try again",
			"scene": "in a story this old."
		},
		{
			"t": 62.58,
			"text": "Jajeun datume",
			"scene": "Watch me anyway."
		},
		{
			"t": 66.14,
			"text": "Myeot beonigo dasi muneojyeodo",
			"scene": "If the vanguard breaks"
		},
		{
			"t": 71.01,
			"text": "Jungyohan geon urirago malhaetdeut",
			"scene": "I will be the reason it reforms,"
		},
		{
			"t": 77.57,
			"text": "Muyemihaji ana",
			"scene": "or the reason they know"
		},
		{
			"t": 81.32,
			"text": "Han georeum deo naaganeun georago",
			"scene": "someone meant it."
		},
		{
			"t": 86.42,
			"text": "Jinannari malhaejugo inneun geol",
			"scene": "Try again."
		},
		{
			"t": 93.94,
			"text": "So whenever you ask me again",
			"scene": "The words are plain. Good."
		},
		{
			"t": 99.96,
			"text": "How I feel",
			"scene": "Plain vows are the ones that hold"
		},
		{
			"t": 101.67,
			"text": "Please remember",
			"scene": "when the poetry burns off."
		},
		{
			"t": 103.99,
			"text": "My answer is you",
			"scene": "Silla can have my class."
		},
		{
			"t": 108.28,
			"text": "Meon gireul dasi doraganda haedo",
			"scene": "Gaya can have my neck"
		},
		{
			"t": 113.32,
			"text": "Nan yeojeonhi gateun mamil tenikka",
			"scene": "if the neck is what the road costs."
		},
		{
			"t": 117.12,
			"text": "We'll be alright",
			"scene": "I'd rather it cost the walking."
		},
		{
			"t": 119.08,
			"text": "I want to try again",
			"scene": "I will walk."
		},
		{
			"t": 122.88,
			"text": "Gateun banbogieodo",
			"scene": "Gate. Shaft of light. Ridiculous hope."
		},
		{
			"t": 124.6,
			"text": "You should know that",
			"scene": "I bow to it and then I move,"
		},
		{
			"t": 126.9,
			"text": "I'm always on your side",
			"scene": "because a vow that only kneels"
		},
		{
			"t": 131.96,
			"text": "Please remember",
			"scene": "is a grave with good manners."
		},
		{
			"t": 134.43,
			"text": "My answer is you",
			"scene": "If I don't come back"
		},
		{
			"t": 138.97,
			"text": "Meon gireul dasi doraganda haedo",
			"scene": "from this attempt,"
		},
		{
			"t": 143.92,
			"text": "Nan yeojeonhi gateun mamil tenikka",
			"scene": "tell them I tried twice"
		},
		{
			"t": 147.95,
			"text": "We'll be alright",
			"scene": "and the second time I was smiling."
		},
		{
			"t": 149.75,
			"text": "I want to try again",
			"scene": "Not wise."
		},
		{
			"t": 158.68,
			"text": "We'll be alright",
			"scene": "Willing."
		},
		{
			"t": 161.57,
			"text": "Please try again",
			"scene": "Again."
		}
	]
}
