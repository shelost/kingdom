	"lines": [
		{
			"t": 0.68,
			"text": "난 이제 더 이상"
		},
		{
			"t": 19.53,
			"text": "그대여 뭘 망설이나요"
		},
		{
			"t": 23.12,
			"text": "그대 원하고 있죠"
		},
		{
			"t": 25.44,
			"text": "눈 앞에 있는 날 (눈 앞에 있는 날)"
		},
		{
			"t": 28.7,
			"text": "알아요 그대 뭘 원하는지"
		},
		{
			"t": 32.68,
			"text": "뭘 기다리는지"
		},
		{
			"t": 35.27,
			"text": "그대여 이리와요 (그대여 이리와요)"
		},
		{
			"t": 38.72,
			"text": "나도 언제까지 그대가"
		},
		{
			"t": 42.43,
			"text": "생각하는 소녀가 아니에요"
		},
		{
			"t": 45.62,
			"text": "이제 나 여자로 태어났죠"
		},
		{
			"t": 49.61,
			"text": "기다려준 그대가 고마울 뿐이죠"
		},
		{
			"t": 53.69,
			"text": "나 이제 그대 입맞춤에 여자가 돼요"
		},
		{
			"t": 57.92,
			"text": "난 이제 더 이상 소녀가 아니에요"
		},
		{
			"t": 61.23,
			"text": "그대 더 이상 망설이지 말아요"
		},
		{
			"t": 63.57,
			"text": "그대 기다렸던 만큼"
		},
		{
			"t": 65.16,
			"text": "나도 오늘을 기다렸어요"
		},
		{
			"t": 68.62,
			"text": "장미 스무송일 내게 줘요"
		},
		{
			"t": 70.73,
			"text": "그대 사랑을 느낄 수 있게"
		},
		{
			"t": 73.39,
			"text": "그댈 기다리며"
		},
		{
			"t": 74.59,
			"text": "나 이제 눈을 감아요"
		},
		{
			"t": 79.61,
			"text": "그대여 나 허락 할래요"
		},
		{
			"t": 83.63,
			"text": "나만을 바라보던 그대의 사랑을"
		},
		{
			"t": 89.46,
			"text": "사랑은 너무나 달콤하고"
		},
		{
			"t": 93.17,
			"text": "향기로운거란 걸"
		},
		{
			"t": 95.7,
			"text": "내게 가르쳐줘요"
		},
		{
			"t": 99.53,
			"text": "항상 힘들어하는 그대"
		},
		{
			"t": 103.39,
			"text": "기다려 주던 그대"
		},
		{
			"t": 105.58,
			"text": "모습 바라보는"
		},
		{
			"t": 107.97,
			"text": "내 마음도 아팠어요"
		},
		{
			"t": 110.33,
			"text": "하지만 이제 내게"
		},
		{
