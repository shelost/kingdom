	const TITLE = { en: 'Borrowed Names', ko: '빌린 이름' };
	const ALT_TITLES = ['Euija’s Grievance', 'Yellow Mountain, Again', 'The Second Samhan'];

	const SYNOPSIS = [
		'Two hundred years after Munmu put Samhan under one roof, the roof is still there. The walls are not. Silla is rich, pious and closed: only the right bones sit at the table, and the provinces have stopped sending rice.',
		'Out of the rot climb three men, and each one borrows the name of a dead kingdom. A coast-guard soldier raised by a tiger (so he says) calls himself king of Baekje and swears to avenge Euija. A one-eyed monk who was thrown from a window as a baby calls himself king of Goguryeo and cuts the Silla king’s face out of a temple wall. A merchant’s son from Songak, who mostly listens, serves the monk until the monk starts reading minds.',
		'The monk dies in a barley field. The soldier sacks the old capital and then loses everything to his own eldest son. In the end he rides at the front of his enemy’s army against that son, and dies on Hwangsan, the plain where Gyebek fell. The merchant’s son wins without ever being the best general in the room. He marries twenty-nine wives, takes in the refugees of Balhae, and keeps the monk’s name for his kingdom: Goryeo.',
		'The sequel is the same chronicle in the same voice. The old sky lord narrates, Kangrim collects the dead, and the reader already knows how the last unification went. This time it is done with weddings.'
	];

	const THEMES: Note[] = [
		{
			title: 'Borrowed names',
			body: [
				'Nobody in this story founds anything new. Gyeon Hwon calls his state Baekje. Gung Ye calls his Goryeo, the name Goguryeo used for itself. Wang Geon keeps Gung Ye’s name after he kills him. The prefix “Later” is the historians’ word, not theirs. Each man wins or loses by how well he wears a dead country’s name.'
			]
		},
		{
			title: 'Seeing and listening',
			body: [
				'Gung Ye has one eye and claims to read hearts. Wang Geon asks questions and lets other people talk until they have told him everything. The one who sees too much dies; the one who listens is crowned.'
			]
		},
		{
			title: 'A grievance outlives everyone',
			body: [
				'Euija’s fall, two and a half centuries old, is a recruiting speech in Jeonju. It ends on the same plain where it began. Wang Geon inherits it anyway: his last will warns his sons off the men of the old Baekje country. The grudge is the only thing in the book that does not die.'
			]
		},
		{
			title: 'Who gets a chair',
			body: [
				'Silla’s bone ranks decide who may marry, rule and dress in purple. Jang Bogo, Choe Chiwon and every castle lord in the provinces hit the same ceiling. The new kings are the men the table would not seat.'
			]
		},
		{
			title: 'Weddings instead of wars',
			body: [
				'Munmu united Samhan with Tang troops and fifteen years of war. Wang Geon does it with marriages, hostages, pardons and a bed for every rival. The book should let the reader feel both are a kind of conquest.'
			]
		},
		{
			title: 'The winner writes it',
			body: [
				'Every account of Gung Ye and Gyeon Hwon was written by Goryeo. The narrator knows it and says so, slyly. The madness, the sack of the capital and the cruelty are recorded, and they may also be propaganda. Let the reader hold both.'
			]
		}
	];

