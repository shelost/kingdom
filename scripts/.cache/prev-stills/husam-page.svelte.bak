					<li><a href={`#${s.id}`}>{s.label}</a></li>
				{/each}
			</ol>
		</nav>

		<article class="column">
			<header class="head">
				<p class="eyebrow">Sequel outline · Later Three Kingdoms · 후삼국</p>
				<h1>{TITLE.en} <span class="ko">{TITLE.ko}</span></h1>
				<p class="meta">
					828–943 · {PARTS.length} parts · {episodeCount} episodes · Also considered: {ALT_TITLES.join(', ')}
				</p>
				<p class="opening">“Two hundred years later, Silla had kept everything except the country.”</p>
			</header>

			<section id="synopsis">
				<h2>Synopsis</h2>
				{#each SYNOPSIS as para, i (i)}
					<p>{para}</p>
				{/each}
			</section>

			<section id="themes">
				<h2>Themes</h2>
				<dl class="notes">
					{#each THEMES as t (t.title)}
						<dt>{t.title}</dt>
						{#each t.body as para, i (i)}
							<dd>{para}</dd>
						{/each}
					{/each}
				</dl>
			</section>

			<section id="chapters">
				<h2>Chapters</h2>
				<p class="lede">
					Each episode opens on one short hook line and ends on a bold next-episode card, like the first book.
					Deaths marked † get Kangrim’s question.
				</p>
				{#each numbered as part (part.id)}
					<section class="part">
						<header class="part-head">
							<h3>{part.title} <span class="ko">{part.ko}</span></h3>
							<span class="years">{part.years}</span>
						</header>
						<p class="part-summary">{part.summary}</p>
						<ol class="episodes">
							{#each part.episodes as ep (ep.n)}
								<li class="episode">
									<details>
										<summary>
											<span class="n">{String(ep.n).padStart(2, '0')}</span>
											<span class="ep-title">
												{ep.title}{#if ep.death}<span class="dagger" title={`${ep.death} dies`}>†</span>{/if}
												<span class="ko">{ep.ko}</span>
											</span>
											<span class="years">{ep.year}</span>
										</summary>
										<div class="ep-body">
											<p class="hook">{ep.hook}</p>
											<ul class="beats">
												{#each ep.beats as beat, i (i)}
													<li>{beat}</li>
												{/each}
											</ul>
											<p class="next"><b>{ep.next}</b></p>
										</div>
									</details>
								</li>
							{/each}
						</ol>
					</section>
				{/each}
			</section>

			<section id="cast">
				<h2>Characters</h2>
				<ul class="cast">
					{#each CAST as c (c.name)}
						<li class="person" style:--c={c.hex}>
							<div class="avatar">
								{#if c.portrait}
									<img src={staticAsset(c.portrait)} alt={c.name} loading="lazy" />
								{:else}
									<span aria-hidden="true">{c.ko.slice(0, 1)}</span>
								{/if}
							</div>
							<div class="person-text">
								<h3>
									{c.name}
									<span class="ko">{c.ko}{c.hanja ? ` ${c.hanja}` : ''}</span>
								</h3>
								<p class="person-meta"><span class="swatch"></span>{c.side} · {c.life}</p>
								<dl>
									<dt>Wants</dt>
									<dd>{c.want}</dd>
									<dt>Voice</dt>
									<dd>{c.voice}</dd>
									<dt>Arc</dt>
									<dd>{c.arc}</dd>
								</dl>
							</div>
						</li>
					{/each}
				</ul>

				<h3 class="sub">Carried over from King for All</h3>
				<dl class="notes">
					{#each RETURNING as r (r.title)}
						<dt>{r.title}</dt>
						{#each r.body as para, i (i)}
							<dd>{para}</dd>
						{/each}
					{/each}
				</dl>
			</section>

			<section id="arcs">
				<h2>Arcs</h2>
				<ul class="arcs">
					{#each ARCS as a (a.who)}
						<li>
							<h3>{a.who}</h3>
							<ol class="steps">
								{#each a.steps as step, i (i)}
									<li>{step}</li>
								{/each}
							</ol>
							<p class="mirror">Mirror: {a.mirror}</p>
						</li>
					{/each}
				</ul>
			</section>

			<section id="plants">
				<h2>Plants and payoffs</h2>
				<table class="plants">
					<thead>
						<tr><th>Plant</th><th>Payoff</th></tr>
					</thead>
					<tbody>
						{#each PLANTS as p (p.plant)}
							<tr><td>{p.plant}</td><td>{p.payoff}</td></tr>
						{/each}
					</tbody>
				</table>
			</section>

			<section id="timeline">
				<h2>Timeline</h2>
				<ol class="timeline">
					{#each TIMELINE as e (e.year + e.text)}
						<li><span class="years">{e.year}</span><span>{e.text}</span></li>
					{/each}
				</ol>
			</section>

			<section id="research">
				<h2>Research</h2>
				<h3 class="sub">Sources</h3>
				<dl class="notes">
					{#each SOURCES as s (s.title)}
						<dt>{s.title}</dt>
						{#each s.body as para, i (i)}
							<dd>{para}</dd>
						{/each}
					{/each}
				</dl>

				<h3 class="sub">The world</h3>
				<dl class="notes">
					{#each RESEARCH as r (r.title)}
						<dt>{r.title}</dt>
						{#each r.body as para, i (i)}
							<dd>{para}</dd>
						{/each}
					{/each}
				</dl>

				<h3 class="sub">Contested or legendary</h3>
				<ul class="plain">
					{#each CONTESTED as c (c)}
						<li>{c}</li>
					{/each}
				</ul>

				<h3 class="sub">Invented for the book</h3>
				<ul class="plain">
					{#each INVENTED as c (c)}
						<li>{c}</li>
					{/each}
				</ul>
			</section>

			<section id="places">
				<h2>Places</h2>
				<table class="plants">
					<thead>
						<tr><th>Place</th><th>Today</th><th>In the story</th></tr>
					</thead>
					<tbody>
						{#each PLACES as p (p.name)}
							<tr>
								<td><b>{p.name}</b> <span class="ko">{p.ko}</span></td>
								<td>{p.now}</td>
								<td>{p.note}</td>
							</tr>
						{/each}
					</tbody>
				</table>
			</section>

			<section id="production">
				<h2>Production</h2>
				<dl class="notes">
					{#each NEEDS as n (n.title)}
						<dt>{n.title}</dt>
						{#each n.body as para, i (i)}
							<dd>{para}</dd>
						{/each}
					{/each}
				</dl>
			</section>
		</article>
	</div>
</main>

