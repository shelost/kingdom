	const RESEARCH: Note[] = [
		{
			title: 'How Silla is run',
			body: [
				'Bone rank decides everything. The holy-bone line ended with Jindeok; true-bone families hold the throne and the top offices. Head-rank six, Choe Chiwon’s class, stops at the sixth grade no matter what. Ranks fix the colour of your robe, the size of your house and whom you may marry.',
				'From the mid-ninth century the throne is a revolving door among true-bone cousins. Central tax collapses after 889.'
			]
		},
		{
			title: 'The castle lords',
			body: [
				'Local strongmen, the hojok, run their own walls and armies and call themselves castle lord or general. They pay whoever protects them. All three founders begin as one of them or by recruiting them, and Goryeo wins by marrying them.'
			]
		},
		{
			title: 'Religion',
			body: [
				'Seon (Zen) monasteries, the Nine Mountains, are funded by the castle lords and preach that anyone can reach awakening. That suits men without good bones.',
				'Maitreya, the Buddha to come, is a revolutionary idea: Gung Ye simply claims to be him.',
				'Geomancy (pungsu), associated with Doseon, reads the land as a body. Wang Geon’s will is full of it.'
			]
		},
		{
			title: 'The sea',
			body: [
				'Silla merchants run the Yellow Sea after Jang Bogo. The Wangs of Songak are a trading house with ships. Gyeon Hwon and Wang Geon both send envoys to the southern Chinese courts (Wuyue, Later Tang), and the war in the southwest is half naval.'
			]
		},
		{
			title: 'Dress and look (production)',
			body: [
				'Since Chunchu’s reform in 649, court men wear Tang-style dress: round-collared robes, belts of rank and the black bokdu cap with stiff wings. The feather jougwan of the first book is an antique here, worn only by a few old castle lords.',
				'Armour stays lamellar steel. The ring-pommel sword is old-fashioned; most blades are plain straight swords. Monks matter on screen: Gung Ye’s gold cowl, the Seon robes.',
				'Palette by state: Later Baekje yellow and rust, Taebong purple-black, Goryeo sea-teal and white, Silla faded crimson.'
			]
		}
	];

	const PLACES: { name: string; ko: string; now: string; note: string }[] = [
		{ name: 'Seorabeol', ko: '서라벌', now: 'Gyeongju', note: 'Silla’s capital to the end; Poseokjeong is here.' },
		{ name: 'Wansanju', ko: '완산주', now: 'Jeonju', note: 'Later Baekje capital from 900.' },
		{ name: 'Songak', ko: '송악', now: 'Kaesong', note: 'The Wang family seat; Gung Ye’s base 898–905; Goryeo capital from 919.' },
		{ name: 'Cheorwon', ko: '철원', now: 'Cheorwon', note: 'Taebong capital 905–918, now in the DMZ.' },
		{ name: 'Naju', ko: '나주', now: 'Naju', note: 'Wang Geon’s port behind Baekje lines; the willow spring.' },
		{ name: 'Cheonghae', ko: '청해', now: 'Wando', note: 'Jang Bogo’s island garrison.' },
		{ name: 'Buseoksa', ko: '부석사', now: 'Yeongju', note: 'Where Gung Ye cuts the king’s portrait.' },
		{ name: 'Haeinsa', ko: '해인사', now: 'Gayasan, Hapcheon', note: 'Choe Chiwon’s retreat.' },
		{ name: 'Geumsansa', ko: '금산사', now: 'Gimje', note: 'Where Singeom locks up his father.' },
		{ name: 'Gongsan', ko: '공산', now: 'Palgongsan, Daegu', note: 'Sin Sung-gyeom’s death.' },
		{ name: 'Gochang', ko: '고창', now: 'Andong', note: 'The castle lords choose Goryeo.' },
		{ name: 'Unju', ko: '운주', now: 'Hongseong', note: 'Yu Geumpil’s charge.' },
		{ name: 'Illicheon', ko: '일리천', now: 'Seonsan, Gumi', note: 'Father against son.' },
		{ name: 'Hwangsan', ko: '황산', now: 'Yeonsan, Nonsan', note: 'Gyebek’s field in 660; Singeom’s surrender and Gyeon Hwon’s death in 936; Gaetaesa.' }
	];

	const CONTESTED: string[] = [
		'Gung Ye’s royal birth. The histories name two possible fathers, and some scholars think the story was his own invention.',
		'How mad Gung Ye really was. The mind-reading and the killings come from the men who overthrew him; modern studies of Taebong often read him as a centralising, Buddhist reformer.',
		'Queen Jinseong’s favourites. The record of lovers and misrule is written by men who had already decided a queen was the problem.',
		'Jang Bogo’s death year: 841 or 846.',
		'Gung Ye’s birth year and the exact date of Choe Chiwon’s disappearance.',
		'The willow leaf, the barley field, the eight generals of Palgongsan and Choe Chiwon’s shoes are folk tradition, not record. Mark them as legend in the narration.',
		'The Ten Injunctions’ eighth article may be a later insertion; some historians doubt it is Wang Geon’s.',
		'Where Gyeon Hwon is buried. The tomb in Nonsan is tradition.'
	];

	const INVENTED: string[] = [
		'The narrator, Kangrim and the cavern sisters, carried over from the first book.',
		'Kangrim failing to find Choe Chiwon.',
		'The Balhae refugee who carries a shard like the one in the first book’s epilogue.',
		'A crow at Gung Ye’s death; the gold cowl burned at Cheorwon.',
		'All dialogue. The recorded speeches and letters go in quote blocks once, and the scenes around them are dramatised.'
	];

	const NEEDS: Note[] = [
		{
			title: 'Portraits',
			body: [
				'Have: Gyeon Hwon (ch_kyun_hwon), Gung Ye (ch_gung_ye). Need: Wang Geon (young admiral and old king), Choe Chiwon, Jinseong, Lady Yu, Lady Oh, Lady Kang, Singeom, Geumgang, Sin Sung-gyeom, Yu Geumpil, Gyeongsun, the Hemp-robed Prince, Jang Bogo, Neungchang, Doseon, Wang Ryung.'
			]
		},
		{
			title: 'Places and flags',
			body: [
				'Place boards for Wansanju, Cheorwon, Songak, Naju spring, Poseokjeong, Geumsansa, Haeinsa and Cheonghae. Hwangsan already exists and should be reused, so 660 and 936 are visibly the same ground.',
				'Banners for Later Baekje, Taebong and Goryeo.'
			]
		},
		{
			title: 'Canon',
			body: [
				'A ninth-century costume chart (round-collared robe and bokdu), Gung Ye’s gold cowl and eyepatch, Wang Geon’s horse, and a never-list so the feather cap doesn’t come back.'
			]
		}
	];

	const SECTIONS = [
		{ id: 'synopsis', label: 'Synopsis' },
		{ id: 'themes', label: 'Themes' },
		{ id: 'chapters', label: 'Chapters' },
		{ id: 'cast', label: 'Characters' },
		{ id: 'arcs', label: 'Arcs' },
		{ id: 'plants', label: 'Plants and payoffs' },
		{ id: 'timeline', label: 'Timeline' },
		{ id: 'research', label: 'Research' },
		{ id: 'places', label: 'Places' },
		{ id: 'production', label: 'Production' }
	];

	const episodeCount = PARTS.reduce((n, p) => n + p.episodes.length, 0);
	const numbered = (() => {
		let n = 0;
		return PARTS.map((p) => ({ ...p, episodes: p.episodes.map((e) => ({ ...e, n: ++n })) }));
	})();
</script>

<svelte:head>
	<title>{TITLE.en} · Sequel outline · King for All</title>
	<meta
		name="description"
		content="Outline for the sequel to King for All, set in the Later Three Kingdoms: Gyeon Hwon, Gung Ye and Wang Geon."
	/>
</svelte:head>

<main class="husam">
	<SiteNavSpace />

	<div class="layout">
		<nav class="toc" aria-label="Outline sections">
			<ol>
